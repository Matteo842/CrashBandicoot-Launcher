<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CrashBandicoot</AssemblyName>
    <RootNamespace>CrashBandicoot.Launcher</RootNamespace>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <Product>Crash Bandicoot: Recompiled</Product>
    <AssemblyTitle>Crash Bandicoot: Recompiled</AssemblyTitle>
    <Description>Unofficial Crash Bandicoot (PS1 NTSC-U) recompilation launcher — not affiliated with Sony, Activision, or Naughty Dog.</Description>
    <Company>Unofficial fan project</Company>
    <Authors>CrashBandicoot-Launcher contributors</Authors>
    <Copyright>Unofficial fan project — Crash Bandicoot belongs to its respective owners</Copyright>
  </PropertyGroup>

  <!-- Windows: native WinForms launcher UI + HWND-embedded game. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from ../icon.png by EnsureAppIcon (BeforeBuild). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Linux / other: CLI prepare/run + standalone Silk game window. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Single-file release (Python-style one-file). User data uses AppPaths.Root = exe folder. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecompOne.Runtime\RecompOne.Runtime.csproj" />
    <ProjectReference Include="..\RecompOne.Recompiler\RecompOne.Recompiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Recomp\CrashBandicoot.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Recomp\Patches\main.cs.patch" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Ui\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WinForms launcher UI is Windows-only; Linux builds keep Recomp + CLI entry. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="LauncherHost.cs" />
    <Compile Remove="Ui\NativeLauncherUi.cs" />
    <Compile Remove="Ui\NativeTheme.cs" />
    <Compile Remove="Ui\ILauncherUi.cs" />
    <Compile Remove="Ui\LauncherUiFactory.cs" />
    <Compile Remove="Ui\WebView2LauncherUi.cs" />
    <Compile Remove="Ui\PhotinoLauncherUi.cs" />
  </ItemGroup>

  <!-- Keep app.ico in sync with repo-root icon.png for title-bar / exe icon (Windows only). -->
  <Target Name="EnsureAppIcon" BeforeTargets="BeforeBuild;BeforePublish"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PropertyGroup>
      <_IconPng>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\icon.png'))</_IconPng>
      <_IconIco>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\app.ico'))</_IconIco>
      <_IconScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\ensure_app_icon.ps1'))</_IconScript>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_IconScript)&quot; -PngPath &quot;$(_IconPng)&quot; -IcoPath &quot;$(_IconIco)&quot;"
          IgnoreExitCode="false" />
  </Target>

</Project>
